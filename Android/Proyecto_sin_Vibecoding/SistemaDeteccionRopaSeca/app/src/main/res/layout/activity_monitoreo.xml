<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F8FC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnVolver"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="Volver"
                android:padding="12dp"
                android:scaleType="center"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Monitoreo"
                android:textColor="#172033"
                android:textSize="28sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Estado -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="ESTADO ACTUAL"
            android:textColor="#667085"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#E8EEF7"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ESPERA"
                android:textColor="#344054"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Mensaje según el estado -->
        <LinearLayout
            android:id="@+id/bloqueMensajeEstado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#E8EEF7"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvTituloMensajeEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Todo listo para comenzar"
                android:textColor="#172033"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvMensajeEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Iniciá un ciclo cuando cuelgues la ropa para comenzar a monitorear el secado."
                android:textColor="#667085"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Datos del ciclo de secado -->
        <LinearLayout
            android:id="@+id/bloqueDatosSecado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Humedad -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="NIVEL DE HUMEDAD"
                android:textColor="#667085"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#E8EEF7"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvHumedad"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- %"
                    android:textColor="#172033"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Humedad detectada en la ropa"
                    android:textColor="#667085"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Progreso -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="PROGRESO DE SECADO"
                android:textColor="#667085"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressSecado"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:layout_marginTop="12dp"
                android:max="100"
                android:progress="0"
                android:progressBackgroundTint="#D0D5DD"
                android:progressTint="#6750A4" />

            <TextView
                android:id="@+id/tvProgreso"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="6dp"
                android:text="0 %"
                android:textColor="#475467"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Última actualización -->
            <TextView
                android:id="@+id/tvUltimaActualizacion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Esperando actualización..."
                android:textColor="#98A2B3"
                android:textSize="13sp" />

        </LinearLayout>

        <!-- Aviso de problemas de conexión -->
        <TextView
            android:id="@+id/tvEstadoConexion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="#E8EEF7"
            android:padding="14dp"
            android:text=""
            android:textColor="#475467"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Botón principal -->
        <Button
            android:id="@+id/btnCiclo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:backgroundTint="#6750A4"
            android:text="INICIAR CICLO"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>